[TEMPLATE]
# Groq API Key (server-side only — NEVER exposed to the frontend)
# Used for: LLM dialogue/extraction (openai/gpt-oss-20b), EHR synthesis
# (openai/gpt-oss-120b), and Whisper-large-v3 voice transcription.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database URL
DATABASE_URL=sqlite:///./medikiosk.db

# Optional model overrides (defaults track Groq's current catalog;
# Groq retires model IDs periodically — if a model 404s, update these)
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_SYNTHESIS_MODEL=openai/gpt-oss-120b
